{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "fill answer（第一階段草案）",
  "description": "使用者提交的填空題答案。blanks 的 key 必須與題目的空格 id 完全一致（語意檢查）。",
  "type": "object",
  "additionalProperties": false,
  "required": ["blanks"],
  "properties": {
    "blanks": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]{1,8}$" },
      "additionalProperties": {
        "type": "string",
        "maxLength": 1000,
        "$comment": "允許空字串（使用者未填，判為錯）。1000 是防止過大輸入的技術上限，可調整。"
      }
    }
  }
}
